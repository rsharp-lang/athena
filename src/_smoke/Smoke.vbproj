<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <MyType>Empty</MyType>
    <Platforms>AnyCPU</Platforms>
    <RootNamespace>Smoke</RootNamespace>
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GenerativeUI\GenerativeUI.vbproj" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="*.json" />
    <None Remove="*.txt" />
    <Content Include="sample_params.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="llm_output.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\AthenaDesktop\Html\launcher.html">
      <Link>launcher.html</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
